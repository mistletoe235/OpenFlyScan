--- a/configs/slrf.yaml
+++ b/configs/slrf.yaml
@@ -26,6 +26,28 @@ spatial_partition: footprint_tree
 # prior: compute footprints from matching cams/*.txt and metric depth/*.exr.
 # sequential: estimate footprints with a preliminary ordered model pass.
 footprint_estimation: sequential
+# Optional reusable cache for sequentially estimated footprints. The cache is
+# accepted only when its ordered image stems exactly match the current scene.
+footprint_cache_path: null
+# Generate/validate the footprint cache and stop before spatial reconstruction.
+footprint_only: false
+# Build and save the exact spatial chunk plan, then stop before model loading.
+# This is useful for auditing view composition before an expensive run.
+chunk_plan_only: false
+# Optional embarrassingly-parallel prediction mode. Every worker loads the
+# same complete chunk plan but predicts only chunk_id % worker_count == index.
+# Use separate cache/output directories, merge their manifests and NPZ files,
+# then run one coordinator with reuse_chunk_cache_dir.
+prediction_only: false
+prediction_worker_index: 0
+prediction_worker_count: 1
+# Optional reusable JSON chunk plan. If it exists, spatial partitioning is
+# skipped and the exact saved chunks/overlaps/alignment tree are restored.
+# A previous output directory or its result.json may also be supplied.
+chunk_plan_path: null
+# Optional chunk_cache directory from a compatible completed run. Requires the
+# v2 manifest and skips model initialization/inference entirely.
+reuse_chunk_cache_dir: null
 max_chunk_size: 32
 min_chunk_size: 8
 max_chunks: 0
@@ -38,12 +60,18 @@ chunk_order: spatial_center_bfs
 # Prior and alignment policy
 # Pi3X only. choices: input, none
 pose_prior: input
+# When trusted poses are provided to Pi3X, use them to place the predicted
+# camera-frame point maps in the world instead of re-predicting those poses.
+# Pi3X's pose branch is a soft attention condition; its camera head is not a
+# hard pose constraint.
+pi3x_anchor_output_to_input_pose: false
 # GeoFF3D only. Required value: input
 translation_prior: input
 # GeoFF3D only. choices: input, none
 rotation_prior: input
-# GeoFF3D and Pi3X. choices: input, pred, none
-ray_prior: pred
+# GeoFF3D and Pi3X. choices: auto, input, pred, none.  ``auto`` uses camera
+# intrinsics when present and bootstraps them from chunk 0 only when absent.
+ray_prior: auto
 # pred: use model-predicted seam depth; none: disable the depth prior.
 # Only input requires a depth/ directory for the depth-prior path.
 depth_prior: pred
@@ -68,6 +96,29 @@ post_chunk_align_spatial_balance: true
 post_chunk_align_workers: 2
 compute_seam_error: true
 seam_error_max_points_per_edge: 20000
+keep_chunk_cache: false
+# Compressed NPZ is smaller but expensive for dense floating-point maps. For
+# node-local transient caches, false is substantially faster and lossless.
+chunk_cache_compressed: true
+chunk_cache_writer_workers: 1
+chunk_cache_max_pending: 0
+# Store only arrays required by alignment and the full-map audit export. This
+# is valid when the optional RRD/mesh/BA/GS/DOM outputs are disabled.
+chunk_cache_compact: false
+# Optional node-local directory for transient window predictions.  Final
+# products remain under output_path; this directory is removed after export.
+transient_chunk_cache_dir: null
+# Persist post-aligned core-view point maps and raw (unthresholded) confidence
+# as the final full-map audit product.  Transient caches can then be deleted.
+export_full_map_bundle: false
+# Per-window colored PLYs duplicate the final full-map product and are disabled
+# for storage-bounded batch runs.
+log_chunks_rrd: true
+save_standard_outputs: true
+full_map_overview_max_points: 2000000
+# Uncompressed shards write much faster and are still standard NPZ files.
+# Keep true for archival runs; use false for fast local production runs.
+full_map_shards_compressed: true
 
 
